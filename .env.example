# Copy to .env.local (never commit it) to turn on "Sync to Notion".
# 1. notion.so/profile/integrations → New integration → copy the Internal Integration Secret
NOTION_TOKEN=
# 2. A Notion database: open it → ••• → Connections → add your integration,
#    then paste the database link (or its 32-character ID) here
NOTION_DATABASE_ID=
